#!/usr/bin/env python3
"""DIY auth handlers: email+password in shared SQLite, self-minted HS256 JWTs.
Stdlib only. Single endpoint; the action is in the JSON body (avoids relying on
kedge subpath routing). Actions: signup, login, me, probe.

No kedge auth policy covers this app — identity is entirely ours, carried in an
Authorization: Bearer header and verified here."""
import base64
import hashlib
import hmac
import json
import os
import secrets
import subprocess
import sys
import time

DB = os.environ.get("AUTH_DB", "/shared.db")
SECRET_FILE = os.environ.get("AUTH_SECRET_FILE", "/shared/auth_secret")
TOKEN_TTL = 30 * 24 * 3600  # 30 days
# scrypt is memory-hard and preferred, but needs OpenSSL support that isn't present
# everywhere; PBKDF2-HMAC-SHA256 is always available in stdlib. Stored hashes are
# tagged with the scheme so both can coexist and be upgraded on next login.
SCRYPT = {"n": 2**14, "r": 8, "p": 1}
PBKDF2_ROUNDS = 600_000  # OWASP guidance for PBKDF2-HMAC-SHA256
HAVE_SCRYPT = hasattr(hashlib, "scrypt")

# NOTE: python's sqlite3 module cannot be used here — any connect() (even
# ":memory:") kills the handler process on kedge, apparently via the LD_PRELOAD
# replication shim. The sqlite3 CLI works, so all data access goes through it.
# Replicated tables must declare a PRIMARY KEY.
# Replicated-table rules learned the hard way: every table needs a PRIMARY KEY,
# and UNIQUE columns are rejected ("requires a reservation backend"). Email is
# therefore the primary key — which also avoids auto-increment ids, a poor fit for
# a multi-region replicated database.
SCHEMA = """
CREATE TABLE IF NOT EXISTS users (
  email TEXT PRIMARY KEY,
  pw_hash TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now'))
);
CREATE TABLE IF NOT EXISTS user_visits (
  email TEXT PRIMARY KEY,
  visits INTEGER NOT NULL DEFAULT 0
);
"""


# ---------- data access via the sqlite3 CLI ----------

def lit(value):
    """SQL literal. Strings become hex blobs cast to text: injection-proof, since
    the rendered literal can only contain [0-9a-f]."""
    if value is None:
        return "NULL"
    if isinstance(value, bool):
        return "1" if value else "0"
    if isinstance(value, int):
        return str(value)
    return f"CAST(x'{str(value).encode().hex()}' AS TEXT)"


def sql(statements, json_out=False):
    """Run SQL through the sqlite3 CLI. Returns parsed rows when json_out."""
    args = ["sqlite3"]
    if json_out:
        args.append("-json")
    args += [DB, statements]
    p = subprocess.run(args, capture_output=True, text=True, timeout=20)
    if p.returncode != 0:
        raise RuntimeError(f"sqlite failed rc={p.returncode}: {p.stderr.strip()[-200:]}")
    if not json_out:
        return p.stdout.strip()
    out = p.stdout.strip()
    return json.loads(out) if out else []


# ---------- crypto (stdlib only) ----------

def get_secret():
    env = os.environ.get("AUTH_SECRET")
    if env:
        return env.encode()
    try:
        with open(SECRET_FILE, "rb") as f:
            return f.read()
    except FileNotFoundError:
        secret = secrets.token_bytes(32)
        fd = os.open(SECRET_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(secret)
        return secret


def _derive(scheme, password, salt):
    if scheme == "scrypt":
        return hashlib.scrypt(password.encode(), salt=salt, **SCRYPT).hex()
    if scheme == "pbkdf2":
        return hashlib.pbkdf2_hmac("sha256", password.encode(), salt, PBKDF2_ROUNDS).hex()
    raise ValueError(f"unknown scheme {scheme}")


def hash_password(password):
    scheme = "scrypt" if HAVE_SCRYPT else "pbkdf2"
    salt = secrets.token_bytes(16)
    return f"{scheme}${salt.hex()}${_derive(scheme, password, salt)}"


def verify_password(password, stored):
    try:
        scheme, salt_hex, digest_hex = stored.split("$")
        digest = _derive(scheme, password, bytes.fromhex(salt_hex))
        return hmac.compare_digest(digest, digest_hex)
    except Exception:
        return False


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def b64url_decode(s):
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def mint_jwt(subject, email, secret, now=None):
    now = int(now or time.time())
    header = b64url(json.dumps({"alg": "HS256", "typ": "JWT"}).encode())
    payload = b64url(json.dumps({
        "sub": str(subject), "email": email, "iat": now, "exp": now + TOKEN_TTL,
    }).encode())
    signing_input = f"{header}.{payload}".encode()
    sig = b64url(hmac.new(secret, signing_input, hashlib.sha256).digest())
    return f"{header}.{payload}.{sig}"


def verify_jwt(token, secret, now=None):
    """Returns the payload dict, or None if invalid/expired."""
    try:
        header_b64, payload_b64, sig_b64 = token.split(".")
        signing_input = f"{header_b64}.{payload_b64}".encode()
        expected = b64url(hmac.new(secret, signing_input, hashlib.sha256).digest())
        if not hmac.compare_digest(expected, sig_b64):
            return None
        header = json.loads(b64url_decode(header_b64))
        if header.get("alg") != "HS256":
            return None
        payload = json.loads(b64url_decode(payload_b64))
        if int(payload.get("exp", 0)) < int(now or time.time()):
            return None
        return payload
    except Exception:
        return None


# ---------- request handling ----------

def respond(status, body):
    sys.stdout.write(f"Status: {status}\r\nContent-Type: application/json\r\n")
    sys.stdout.write("Cache-Control: private, no-store\r\n\r\n")
    sys.stdout.write(json.dumps(body))
    sys.exit(0)


def bearer_token():
    auth = os.environ.get("HTTP_AUTHORIZATION", "")
    if auth.lower().startswith("bearer "):
        return auth[7:].strip()
    return None


def main():
    if os.environ.get("REQUEST_METHOD", "GET").upper() != "POST":
        respond(405, {"error": "POST a JSON body with an 'action' field"})
    try:
        length = int(os.environ.get("CONTENT_LENGTH") or 0)
        req = json.loads(sys.stdin.read(length) if length else sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        respond(400, {"error": "invalid JSON"})
    action = req.get("action")

    if action == "probe":
        import subprocess as sp

        ENGINE = "/usr/local/lib/syzy-engine.so"

        def run_py(code):
            try:
                p = sp.run([sys.executable, "-c", code], capture_output=True,
                           text=True, timeout=30)
                return {"rc": p.returncode, "out": p.stdout.strip()[-200:],
                        "err": p.stderr.strip()[-300:]}
            except Exception as e:
                return f"{type(e).__name__}: {e}"

        tests = {
            "plain_memory": "import sqlite3;c=sqlite3.connect(':memory:');print(c.execute('select 1').fetchone())",
            "plain_shared": "import sqlite3;c=sqlite3.connect('/shared.db');print(c.execute('select 42').fetchone())",
            "enable_ext": "import sqlite3;c=sqlite3.connect(':memory:');c.enable_load_extension(True);print('ok')",
            "load_ext_shared": ("import sqlite3;c=sqlite3.connect('/shared.db');"
                                "c.enable_load_extension(True);"
                                "c.execute(\"SELECT load_extension('" + ENGINE + "','sqlite3_syzy_init')\");"
                                "print(c.execute('select 42').fetchone())"),
        }
        diag = {
            "engine_so_exists": os.path.exists(ENGINE),
            "python_version": sys.version.split()[0],
        }
        only = req.get("step")
        for name, code in tests.items():
            if only and name != only:
                continue
            diag[name] = run_py(code)
        respond(200, diag)

    try:
        sql(SCHEMA)
        secret = get_secret()
    except Exception as e:
        respond(500, {"error": f"init failed: {type(e).__name__}: {e}"})

    if action == "signup":
        email = str(req.get("email", "")).strip().lower()
        password = str(req.get("password", ""))
        if "@" not in email or len(email) > 254:
            respond(400, {"error": "valid email required"})
        if len(password) < 8:
            respond(400, {"error": "password must be at least 8 characters"})
        existing = sql(f"SELECT email FROM users WHERE email = {lit(email)};", json_out=True)
        if existing:
            respond(409, {"error": "that email is already registered"})
        sql(f"INSERT INTO users (email, pw_hash) VALUES "
            f"({lit(email)}, {lit(hash_password(password))});")
        if not sql(f"SELECT email FROM users WHERE email = {lit(email)};", json_out=True):
            respond(500, {"error": "signup did not persist"})
        respond(201, {"token": mint_jwt(email, email, secret)})

    if action == "login":
        email = str(req.get("email", "")).strip().lower()
        password = str(req.get("password", ""))
        rows = sql(f"SELECT pw_hash FROM users WHERE email = {lit(email)};", json_out=True)
        # verify against a dummy hash when unknown: same timing, no user enumeration
        stored = rows[0]["pw_hash"] if rows else hash_password("dummy-password")
        if not rows or not verify_password(password, stored):
            respond(401, {"error": "email or password incorrect"})
        respond(200, {"token": mint_jwt(email, email, secret)})

    if action == "me":
        token = bearer_token()
        payload = verify_jwt(token, secret) if token else None
        if not payload:
            respond(401, {"error": "missing or invalid token"})
        user = payload["sub"]
        # per-user state written by backend code: the thing kedge auth couldn't do
        sql(f"INSERT INTO user_visits (email, visits) VALUES ({lit(user)}, 1) "
            f"ON CONFLICT(email) DO UPDATE SET visits = visits + 1;")
        rows = sql(f"SELECT visits FROM user_visits WHERE email = {lit(user)};",
                   json_out=True)
        respond(200, {"sub": payload["sub"], "email": payload["email"],
                      "expires": payload["exp"],
                      "your_visit_count": rows[0]["visits"] if rows else 0})

    respond(400, {"error": f"unknown action: {action!r}"})


main()
